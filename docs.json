          },
          {
            "group": "Connections",
            "pages": [
              "GET /api/v1/connections",
              "POST /api/v1/connections",
              "GET /api/v1/connections/{id}",
              "PATCH /api/v1/connections/{id}",
              "DELETE /api/v1/connections/{id}",
              "POST /api/v1/connections/{id}/rotate",
              {
                "group": "Hosts",
                "pages": [
                  "GET /api/v1/connections/{id}/hosts",
                  "POST /api/v1/connections/{id}/hosts",
                  "DELETE /api/v1/connections/{id}/hosts/{host}"
                ]
              },
              {
                "group": "Connected apps",
                "pages": [
                  "POST /api/v1/connections/oauth/{provider}/connect-url",
                  "POST /api/v1/connections/{id}/connect-url",
                  "POST /api/v1/connections/{id}/placements",
                  "DELETE /api/v1/connections/{id}/placements/{pid}"
                ]
              },
              {
                "group": "MCP servers",
                "pages": [
                  "POST /api/v1/connections/mcp",
                  "POST /api/v1/connections/mcp/{id}/finish"
                ]
              },
              {
                "group": "Provider apps",
                "pages": [
                  "GET /api/v1/connections/provider-apps/{provider}",
                  "PUT /api/v1/connections/provider-apps/{provider}",
                  "DELETE /api/v1/connections/provider-apps/{provider}"
                ]
              },
              {
                "group": "Your own OAuth client",
                "pages": [
                  "GET /api/v1/oauth-apps/{app}",
                  "PUT /api/v1/oauth-apps/{app}",
                  "DELETE /api/v1/oauth-apps/{app}"
                ]
              }
            ]
          }
        ]
      }
