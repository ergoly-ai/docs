  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://www.ergoly.ai/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://control.ergoly.ai/"
    }
  },
  "footer": {
    "socials": {
      "website": "https://www.ergoly.ai",
      "linkedin": "https://www.linkedin.com/company/ergoly",
      "github": "https://github.com/ergoly-ai"
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.ergoly.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "redirects": [
    {
      "source": "/docs",
      "destination": "/"
    },
    {
      "source": "/docs/technical/glossary",
      "destination": "/glossary"
    },
    {
      "source": "/docs/:slug*",
      "destination": "/:slug*"
    },
    {
      "source": "/technical/glossary",
      "destination": "/glossary"
    }
  ],
  "banner": {
    "content": "Ergoly is hiring. <a href=\"https://www.ergoly.ai/jobs\">Apply today</a>.",
    "dismissible": true
  },
  "interaction": {
    "drilldown": false
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required"
    }
  }
}
